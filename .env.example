# SiliconFlow API key
#
# Copy this file to .env:
#
#   cp .env.example .env
#
# Then replace the placeholder with your own API key.

SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Optional PDF library root.
# LiteratureAgent recursively scans all subfolders for PDF files.
# Leave empty to use ./data/papers.
LITERATURE_AGENT_PAPERS_DIR=